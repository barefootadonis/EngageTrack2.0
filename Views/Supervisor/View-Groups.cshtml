@{
    ViewData["Title"] = "View Group";
    ViewData["FullWidth"] = true;
}

if (Model == null)
{
<div class="alert alert-danger">
    <strong>Error:</strong> Group not found.
</div>
}
else
{
showGroupDetails(Model);
}

<section class="group-card">
    <div class="card">
        <div class="card-header">
            <h2>@Model.Name</h2>
        </div>
        <div class="card-body">
            <p>@Model.Description</p>
            <p><strong>Members:</strong> @Model.Members.Count</p>
            <p><strong>CRF:</strong> @Model.CRF</p>
        </div>
    </div>
</section>




