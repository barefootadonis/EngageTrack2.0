@model EngageTrack.Models.Group

@{
    ViewData["Title"] = "View Group";
    ViewData["FullWidth"] = true;
}

<h2>Group Details</h2>

<div class="group-details">
    <div class="group-details-header">
        <h4>@Model.GroupName</h4>
    </div>
    <div class="group-details-body">
        <dl class="row">
            <dt class="col-sm-2">Group ID:</dt>
            <dd class="col-sm-10">@Model.GroupId</dd>

            <dt class="col-sm-2">Project:</dt>
            <dd class="col-sm-10">@Model.ProjectName</dd>

            <dt class="col-sm-2">Project Summary:</dt>
            <dd class="col-sm-10">@Model.ProjectSummary</dd>

            <dt class="col-sm-2">Current Members:</dt>
            <dd class="col-sm-10">@Model.CurrentMembers</dd>

            <dt class="col-sm-2">Max Members:</dt>
            <dd class="col-sm-10">@Model.MaxMembers</dd>

            <dt class="col-sm-2">Change Request:</dt>
            <dd class="col-sm-10">@(Model.GroupChangeRequest ? "Yes" : "No")</dd>

            <dt class="col-sm-2">Active:</dt>
            <dd class="col-sm-10">@(Model.GroupIsActive ? "Yes" : "No")</dd>
        </dl>
    </div>
</div>
<br /><a asp-action="Index" class="btn btn-secondary">Back to Groups</a>